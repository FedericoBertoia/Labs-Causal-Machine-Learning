# ── NIE through M1 only (job search self-efficacy) ────────────────────────────
nie_MY <- medoutcon(
W = W, A = A, Z = NULL,
M = M1,
Y = Y,
g_learners = sl_bin,
h_learners = sl_bin,
b_learners = sl_cont,
